{
  "name": "vaccine-registration-backend",
  "version": "2.0.0",
  "description": "Backend Developer Assignment - Vaccine Registration APIs (Node.js + MongoDB)",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:slots": "node scripts/seedSlots.js",
    "seed": "npm run seed:slots && npm run seed:admin",
    "test": "cross-env NODE_ENV=test jest --config jest.config.js --runInBand",
    "test:unit": "cross-env NODE_ENV=test jest --config jest.unit.config.js",
    "test:integration": "cross-env NODE_ENV=test jest --config jest.config.js --runInBand tests/integration",
    "test:coverage": "cross-env NODE_ENV=test jest --config jest.config.js --runInBand --coverage"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "vaccine"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true
  }
}
