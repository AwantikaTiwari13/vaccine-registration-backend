# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# Database (MongoDB Atlas)
# Create a free M0 cluster, add a database user, allow your IP, then paste the
# SRV connection string here. Never commit a real URI.
# ---------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vaccine_registration?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Auth
# JWT_SECRET must be a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Admin seed credentials (consumed by `npm run seed:admin`)
# ---------------------------------------------------------------------------
ADMIN_NAME=System Admin
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ---------------------------------------------------------------------------
# Vaccination drive window.
# Defaults are the values fixed by the assignment (1 Nov 2024 - 30 Nov 2024).
# All slot times are interpreted and stored in UTC.
# Override ONLY for local demos; leave unset for an assignment-compliant run.
# ---------------------------------------------------------------------------
# VACCINATION_START=2024-11-01
# VACCINATION_END=2024-11-30

# ---------------------------------------------------------------------------
# Deterministic time injection for testing/demo.
# When ALLOW_MOCK_TIME=true AND NODE_ENV is not "production", requests may send
# an `x-mock-time` header (ISO-8601) to override "now" for that request only.
# This is force-disabled when NODE_ENV=production.
# ---------------------------------------------------------------------------
ALLOW_MOCK_TIME=false
