                "description": "Only honoured when ALLOW_MOCK_TIME=true and NODE_ENV is not production. Remove for real-time behaviour."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users?age=28",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "age",
                  "value": "28"
                }
              ]
            },
            "description": "Exact age. `minAge` and `maxAge` give an inclusive range instead."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter users by pincode",
          "request": {
            "method": "GET",
            "header": [
