                "description": "Only honoured when ALLOW_MOCK_TIME=true and NODE_ENV is not production. Remove for real-time behaviour."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": "Profile with masked Aadhaar, current vaccination status, the dose you may book next, and your bookings."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('no password hash', () => pm.expect(pm.response.text()).to.not.include('passwordHash'));"
                ]
              }
            }
          ]
        }
      ]
