    {
      "name": "2. User - slots and bookings",
      "item": [
        {
          "name": "Get available slots",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "x-mock-time",
                "value": "{{mockTime}}",
                "description": "Only honoured when ALLOW_MOCK_TIME=true and NODE_ENV is not production. Remove for real-time behaviour."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/slots/available?date={{date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "slots",
                "available"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}"
                }
              ]
            },
            "description": "Returns slots on `date` that are inside the drive, have not started, and still have capacity - plus the dose this user is eligible for. Saves the first two slot ids."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('slots returned', () => pm.expect(d.slots.length).to.be.above(1));",
                  "pm.environment.set('slotId', d.slots[0].id);",
                  "pm.environment.set('altSlotId', d.slots[1].id);",
                  "console.log('eligible dose:', d.eligibleDose);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get available slots - outside drive (400)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "x-mock-time",
                "value": "{{mockTime}}",
                "description": "Only honoured when ALLOW_MOCK_TIME=true and NODE_ENV is not production. Remove for real-time behaviour."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/slots/available?date=2024-12-05",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "slots",
                "available"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2024-12-05"
                }
              ]
            },
            "description": "Expected to fail - the drive runs 2024-11-01 to 2024-11-30."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('DATE_OUTSIDE_DRIVE', () => pm.expect(pm.response.json().error.code).to.eql('DATE_OUTSIDE_DRIVE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Book first dose",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "x-mock-time",
                "value": "{{mockTime}}",
                "description": "Only honoured when ALLOW_MOCK_TIME=true and NODE_ENV is not production. Remove for real-time behaviour."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings"
              ]
            },
            "description": "`doseNumber` is optional - omit it and the server books the only dose you are eligible for.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\",\n  \"doseNumber\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.environment.set('bookingId', d.booking.id);",
                  "pm.test('a dose was consumed', () => pm.expect(d.slot.availableDoses).to.be.below(10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Book second dose (before first completes -> 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "x-mock-time",
                "value": "{{mockTime}}",
                "description": "Only honoured when ALLOW_MOCK_TIME=true and NODE_ENV is not production. Remove for real-time behaviour."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings"
              ]
            },
            "description": "Expected to fail until the first dose slot has lapsed. To book a real second dose, set `mockTime` to an instant after the first slot's end time and send this request without `doseNumber`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{altSlotId}}\",\n  \"doseNumber\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('FIRST_DOSE_NOT_COMPLETED', () => pm.expect(pm.response.json().error.code).to.eql('FIRST_DOSE_NOT_COMPLETED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List my bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
