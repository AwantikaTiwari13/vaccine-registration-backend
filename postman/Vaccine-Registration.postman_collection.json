{
  "info": {
    "_postman_id": "3b7c7ab1-923a-4f33-a8a3-b880f275ae07",
    "name": "Vaccine Registration API",
    "description": "Runo Backend Developer Assignment - I.\n\nImport the matching environment file and run the folders top to bottom.\nLogin requests save `userToken` / `adminToken`; slot and booking requests save `slotId`, `altSlotId` and `bookingId` automatically.\n\nIMPORTANT: the vaccination drive is fixed to November 2024. Every request sends an `x-mock-time` header (the `mockTime` variable) so the API can be exercised today. It is only honoured when the server runs with ALLOW_MOCK_TIME=true and NODE_ENV != production; in production the middleware is not mounted at all. Delete the header to use real time.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-mock-time",
                "value": "{{mockTime}}",
                "description": "Only honoured when ALLOW_MOCK_TIME=true and NODE_ENV is not production. Remove for real-time behaviour."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "No auth. Reports environment, drive configuration and whether mock time is enabled."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('drive configured', () => pm.expect(pm.response.json().data.drive.slotsPerDay).to.eql(14));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-mock-time",
                "value": "{{mockTime}}",
                "description": "Only honoured when ALLOW_MOCK_TIME=true and NODE_ENV is not production. Remove for real-time behaviour."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates a user. Phone and Aadhaar are unique. Password is bcrypt-hashed; Aadhaar comes back masked.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"phoneNumber\": \"{{userPhone}}\",\n  \"age\": 28,\n  \"pincode\": \"226001\",\n  \"aadharNo\": \"{{userAadhar}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data.user;",
                  "pm.test('Aadhaar is masked', () => pm.expect(d.aadharNo).to.match(/^X{8}\\d{4}$/));",
                  "pm.test('status starts at NONE', () => pm.expect(d.vaccinationStatus).to.eql('NONE'));",
                  "pm.environment.set('userId', d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register user - duplicate phone (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-mock-time",
                "value": "{{mockTime}}",
                "description": "Only honoured when ALLOW_MOCK_TIME=true and NODE_ENV is not production. Remove for real-time behaviour."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Expected to fail - demonstrates the unique phone-number constraint.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate Phone\",\n  \"phoneNumber\": \"{{userPhone}}\",\n  \"age\": 31,\n  \"pincode\": \"110001\",\n  \"aadharNo\": \"999988887777\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('DUPLICATE_KEY', () => pm.expect(pm.response.json().error.code).to.eql('DUPLICATE_KEY'));"
                ]
              }
            }
          ]
        },
